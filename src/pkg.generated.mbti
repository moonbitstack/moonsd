pub async fn PreparedQuery::delete(Self, String, options? : WriteOptions) -> WriteMeta raise Refused
pub async fn PreparedQuery::execute(Self, String, params? : PreparedQueryExecuteParams, options? : QueryOptions) -> (PreparedQueryExecuteResponse, QueryMeta) raise Refused
pub async fn PreparedQuery::get(Self, String, options? : QueryOptions) -> (Array[PreparedQueryDefinition], QueryMeta) raise Refused
pub async fn PreparedQuery::list(Self, options? : QueryOptions) -> (Array[PreparedQueryDefinition], QueryMeta) raise Refused
pub async fn PreparedQuery::update(Self, PreparedQueryDefinition, options? : WriteOptions) -> WriteMeta raise Refused

