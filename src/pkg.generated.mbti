  datacenters : Array[String]?
}

pub(all) struct QueryMeta {
  last_index : UInt64
  last_hash : String?
  last_contact : Int64
  known_leader : Bool
  request_time : Int64
}

pub(all) struct QueryOptions {
  datacenter : String?
  ns : String?
  token : String?
  wait_index : UInt64?
  wait_hash : String?
  wait_time : Int64?
  consistency : ConsistencyMode
  near : String?
  filter : String?
  node_meta : Map[String, String]?
}

