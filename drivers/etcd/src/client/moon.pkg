// moonetcd/client: the native transports. One `Client` dials one or more etcd
// endpoints over gRPC (one connection per member, each call taking the next in turn,
// and a multiplexed channel per bidi session so a stream can reconnect from the last
// revision) or over etcd's HTTP/JSON gateway, and hands out the same typed handles
// either way.
//
// Native only: the transports open real TCP connections.
supported_targets = "native"

import {
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/async",
  "moonbitstack/moonrpc/net",
  "moonbitstack/moonrpc/wire",
  "moonbitstack/moonrpc/proto",
  "moonbitstack/moonhttp/header",
  "moonbitstack/moonhttp/http1",
  "moonbitstack/moonnet/tcp",
  "moonbitstack/mooncred/x509",
  "moonbitstack/mooncred/roots",
  "moonbitstack/moontls/tls",
  "moonbitstack/moonetcd",
}

import {
  "moonbitstack/moonetcd",
} for "wbtest"
