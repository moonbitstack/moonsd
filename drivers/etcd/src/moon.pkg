// moonetcd: an etcd v3 client for MoonBit. The root package holds the protobuf
// message types and codecs for the etcd v3 API (etcdserverpb and the mvccpb
// values it carries); the gRPC transport lives in `moonetcd/client`, and the
// client-side concurrency helpers in `moonetcd/concurrency`.
import {
  "moonbitlang/core/json",
  "moonbitstack/moonrpc/proto",
  "moonbitstack/moonbase/base64",
}
